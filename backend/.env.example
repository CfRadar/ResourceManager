# Environment Variables for Resource Manager – Express Backend
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file. The .gitignore already excludes it.

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────
# PostgreSQL (Knex)
# Use DATABASE_URL *or* individual fields – env.js accepts both.
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/resource_manager
# Alternatively supply individual vars:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=resource_manager
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_SSL=false

# ─────────────────────────────────────────────
# JWT (keep these long random strings – never share)
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# Internal service communication (Express → Python AI)
# ─────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_KEY=replace_with_a_shared_secret_for_internal_calls

# ─────────────────────────────────────────────
# Rate limiting (optional overrides)
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
